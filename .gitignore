# data/ 子目录 = 运行数据(配置/密钥/日志) —— 永不入库
/data/

# 根目录配置(install.sh 会把 gatewayKey/渠道 apiKey 明文写进 config.json)
/config*.json

# 运行期统计快照(gateway.js flushStats 写在配置同目录)
/stats-*.json

# 运行期产物(历史遗留, 兜底)
log/
.run/
*.log
*.pid
*.sock
*.agwbak
*.deleted.*
.current-key-default
.keyrotation.json
ctx-limits.json
backups/
*.bak-*
*.bak
*.orig
*.key
*.pem
tls/legacy/

# 口令与私钥
.agwkey
tls/ca.key
*.srl
*.deb
/packaging/ai-gateway/opt/ai-gateway/packaging/
packaging/ai-gateway/opt/ai-gateway/
