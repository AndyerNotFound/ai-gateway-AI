[Unit]
Description=AI Gateway (multi-instance pool)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ai-gateway
ExecStart=/usr/bin/node /opt/ai-gateway/gateway.js /opt/ai-gateway/data/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/ai-gateway
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
