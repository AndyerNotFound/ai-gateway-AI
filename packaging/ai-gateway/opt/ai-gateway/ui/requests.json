{
 "gcui": 1,
 "title": "请求",
 "data": {
  "requests": {
   "limit": 40
  },
  "stats": {}
 },
 "root": {
  "type": "column",
  "gap": 12,
  "children": [
   {
    "type": "row",
    "gap": 8,
    "children": [
     {
      "type": "text",
      "text": "{{state.inst}}",
      "style": "title",
      "weight": 1
     },
     {
      "type": "badge",
      "text": "错误 {{state.stats.errors}}",
      "tone": "danger",
      "toneMap": {
       "错误 0": "ok"
      }
     },
     {
      "type": "button",
      "text": "刷新",
      "style": "tonal",
      "action": {
       "type": "reload"
      }
     }
    ]
   },
   {
    "type": "tabs",
    "key": "rt",
    "items": [
     {
      "label": "表格",
      "children": [
       {
        "type": "table",
        "rows": "{{state.requests}}",
        "gap": 4,
        "empty": "还没有请求",
        "columns": [
         {
          "key": "time",
          "label": "时间",
          "weight": 3
         },
         {
          "key": "model",
          "label": "模型",
          "weight": 3
         },
         {
          "key": "duration",
          "label": "ms",
          "weight": 1,
          "via": "{{item.duration}}",
          "tone": "muted"
         },
         {
          "key": "status",
          "label": "状态",
          "weight": 1,
          "toneMap": {
           "200": "ok",
           "2xx": "ok",
           "4xx": "warn",
           "5xx": "danger"
          }
         }
        ],
        "rowAction": {
         "type": "copy",
         "text": "{{item.time}} {{item.model}} {{item.status}} {{item.duration}}ms"
        }
       }
      ]
     },
     {
      "label": "概览",
      "children": [
       {
        "type": "card",
        "children": [
         {
          "type": "kv",
          "label": "请求数",
          "value": "{{state.stats.requests}}"
         },
         {
          "type": "kv",
          "label": "在跑",
          "value": "{{state.stats.inflight}}"
         },
         {
          "type": "kv",
          "label": "错误 / 重试",
          "value": "{{state.stats.errors}} / {{state.stats.retries}}"
         },
         {
          "type": "kv",
          "label": "当前模型",
          "value": "{{state.stats.context.model}}"
         },
         {
          "type": "kv",
          "label": "当前渠道",
          "value": "{{state.stats.context.channel}}"
         },
         {
          "type": "kv",
          "label": "上下文",
          "value": "{{state.stats.context.prompt}} / {{state.stats.context.window}}"
         },
         {
          "type": "progress",
          "value": "{{state.stats.context.percent}}",
          "max": 100
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 }
}