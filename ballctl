/** ballctl get data */
function redact(x) {
  if (Array.isArray(x)) return x.map(redact);
  if (x && typeof x === 'object') {
    const out = {};
    for (const k of Object.keys(x)) {
      const secret = /(gatewayKey|adminKey|apiKey|authKey|secret|password)$/i.test(k);
      out[k] = secret && typeof x[k] === 'string' ? '***' : redact(x[k]);
    }
    return out;
  }
  return x;
}

