function api(inst, cb) {
  let key = '';
  try { key = fs.readFileSync(path.join(os.homedir(), '.ballkey'), 'utf8').trim(); } catch (_) {}
  const req = http.request({
    host: '127.0.0.1', port: 16384, path: '/admin/api/ball/' + encodeURIComponent(inst),
    method: 'GET', ca: fs.existsSync(CA_PEM) ? fs.readFileSync(CA_PEM) : undefined,
    rejectUnauthorized: !fs.existsSync(CA_PEM), headers: key ? { 'x-admin-key': key } : {}
  }, res => { let b = ''; res.on('data', d => b += d); res.on('end', () => { try { cb(null, JSON.parse(b)); } catch (e) { cb(e); } }); });
  req.on('error', e => cb(e));
  req.end();
}

// ---------------- check data ----------------
function getJson(pathname) {
  return new Promise(resolve => {
    let key = '';
    try { key = fs.readFileSync(path.join(os.homedir(), '.ballkey'), 'utf8').trim(); } catch (_) {}
    const req = http.request({
      host: '127.0.0.1', port: 16384, path: pathname, method: 'GET',
      ca: fs.existsSync(CA_PEM) ? fs.readFileSync(CA_PEM) : undefined,
      rejectUnauthorized: !fs.existsSync(CA_PEM), headers: key ? { 'x-admin-key': key } : {}
    }, res => {
      let b = '';
      res.on('data', d => b += d);
      res.on('end', () => { try { resolve(JSON.parse(b)); } catch (e) { resolve(null); } });
    });
    req.on('error', () => resolve(null));
    req.end();
  });
}

function pick(obj, path) {
  let cur = obj;
  for (const part of path.split('.')) {
    if (cur === null || cur === undefined) return undefined;
    if (Array.isArray(cur)) { const i = Number(part); if (!Number.isFinite(i)) return undefined; cur = cur[i]; }
    else if (typeof cur === 'object') cur = cur[part];
    else return undefined;
  }
  return cur;
}

async function checkData(inst) {
  const o = merged(inst);
  const roots = {
    stats: '/admin/api/stats?instance=' + encodeURIComponent(inst),
    active: '/admin/api/active',
    config: '/admin/api/config/' + encodeURIComponent(inst),
    instances: '/admin/api/instances'
  };
  const cache = {};
  for (const [k, v] of Object.entries(roots)) cache[k] = await getJson(v);
  const snap = {
    stats: cache.stats, active: cache.active, config: cache.config, instances: cache.instances,
    inst: inst, local: { note: 'APP 本地量，命令行无法取值' }
  };
  const rows = [];
  for (const k of Object.keys(o)) {
    if (/^ring_/.test(k) && o[k] && o[k].data) rows.push([k, o[k].data]);
  }
  // 旧格式: rings[].from
  (o.rings || []).forEach((r, i) => { if (r.from) rows.push(['rings[' + i + ']', r.from]); });
  if (o.bubble && o.bubble.data) rows.push(['bubble', o.bubble.data]);
  if (o.content && o.content.data) rows.push(['content', o.content.data]);
  if (!rows.length) { console.log('没有声明任何 data'); return; }

  console.log('\n检查 ' + rows.length + ' 条 data（实例 ' + inst + '）\n');
  for (const [where, spec] of rows) {
    const [expr, div] = String(spec).split('/');
    const denied = DENY.some(d => expr.startsWith(d));
    if (denied) { console.log('  ' + where.padEnd(10) + spec.padEnd(34) + '拒绝：敏感路径'); continue; }
    if (BUILTIN.includes(expr)) {
      console.log('  ' + where.padEnd(10) + spec.padEnd(34) + '内置量（APP 侧计算）');
      continue;
    }
    const v = pick(snap, expr);
    if (v === undefined) { console.log('  ' + where.padEnd(10) + spec.padEnd(34) + '✗ 取不到（路径不存在）'); continue; }
    let out = v;
    if (div !== undefined) {
      const d = BUILTIN.includes(div) ? undefined : pick(snap, div);
      const dv = d !== undefined ? d : Number(div);
      out = (dv && Number.isFinite(Number(v))) ? (Number(v) / Number(dv)) : undefined;
      if (out === undefined) { console.log('  ' + where.padEnd(10) + spec.padEnd(34) + '✗ 除数取不到'); continue; }
      out = Math.max(0, Math.min(1, out)).toFixed(3) + '  (比例)';
    }
    console.log('  ' + where.padEnd(10) + spec.padEnd(34) + '✓ ' + JSON.stringify(v) + (div !== undefined ? '  → ' + out : ''));
  }
  console.log('');
}

