function die(m) { console.error('错误: ' + m); process.exit(1); }
function instances() {
  const out = [];
  try { for (const f of fs.readdirSync(DIR)) { const m = /^ball\.(.+)\.json$/.exec(f); if (m) out.push(m[1]); } } catch (_) {}
  out.push('global');
  return out;
}
function activeInstance() {
  const all = instances().filter(x => x !== 'global');
  return all.length === 1 ? all[0] : (all[0] || 'global');
}
function fileFor(inst) {
  return (!inst || inst === 'global') ? path.join(DIR, 'ball.json') : path.join(DIR, 'ball.' + inst + '.json');
}
function readJson(p) { try { return JSON.parse(fs.readFileSync(p, 'utf8')); } catch (_) { return {}; } }
function writeJson(p, o) { fs.writeFileSync(p, JSON.stringify(o, null, 1) + '\n'); }
function merged(inst) {
  const g = readJson(fileFor('global'));
  const o = inst === 'global' ? g : Object.assign({}, g, readJson(fileFor(inst)));
  return o;
}

function parseRing(s) {
  const [left, color] = s.split(':');
  if (color && !TONES.includes(color)) die('颜色只能 ' + TONES.join('/') + '：' + s);
  if (left.includes('/')) {
    const [v, m] = left.split('/').map(Number);
    if (!Number.isFinite(v) || !Number.isFinite(m)) die('值写法应为 35/100:info：' + s);
    return { value: v, max: m, color: color || 'primary' };
  }
  return { data: left, color: color || 'primary' };
}
function parseAction(spec) {
  const i = spec.indexOf(':');
  const type = i < 0 ? spec : spec.slice(0, i);
  const arg = i < 0 ? null : spec.slice(i + 1);
  const a = { type };
  if (arg) {
    if (type === 'open') a.page = arg;
    else if (type === 'mute') a.minutes = Number(arg) || 30;
    else if (type === 'intent') a.endpoint = arg;
    else a.text = arg;
  }
  return a;
}
function splitKV(s, what) {
  const i = s.indexOf('=');
  if (i < 0) die(what + ' 写法应为 键=值：' + s);
  return [s.slice(0, i), s.slice(i + 1)];
}

/** 整组重写: ring_0 ring_1 … 顺序 = 数组顺序 */
function setGroup(o, prefix, items) {
  for (const k of Object.keys(o)) if (k.indexOf(prefix) === 0) delete o[k];
  items.forEach((it, i) => { o[prefix + i] = Object.assign({ order: i }, it); });
  return items.length;
}

function touchSpec(s) {
  const [k, a] = splitKV(s, '手势');
  if (k === 'long_hold') return { on: k, hold: Number(a) || 500 };
  if (!['click', 'double', 'long'].includes(k)) die('手势只能是 click/double/long/long_hold');
  return { on: k, do: parseAction(a) };
}

function applySet(o, g, specs) {
  if (g === 'ring') return setGroup(o, 'ring_', specs.map(parseRing)) + ' 圈';
  if (g === 'content') {
    return setGroup(o, 'content_', specs.map(s => {
      const [l, v] = splitKV(s, '行');
      return { label: l, text: v };
    })) + ' 行';
  }
  if (g === 'radial') {
    return setGroup(o, 'radial_', specs.map(s => {
      const [l, a] = splitKV(s, '按钮');
      return { label: l, do: parseAction(a) };
    })) + ' 个按钮';
  }
  if (g === 'touch') return setGroup(o, 'touch_', specs.map(touchSpec)) + ' 个手势';
  if (g === 'ringStyle') {
    o.ringStyle = o.ringStyle || {};
    for (const s of specs) {
      const [k, v] = splitKV(s, 'ringStyle');
      o.ringStyle[k] = ['mode', 'side'].includes(k) ? v : Number(v);
    }
    return JSON.stringify(o.ringStyle);
  }
  die('set 只支持 ring / content / radial / touch / ringStyle');
}

const PREFIX = { ring: 'ring_', content: 'content_', radial: 'radial_', touch: 'touch_', chain: 'chain_' };

function applyEdit(o, g, sel, val) {
  if (g === 'ring') {
    const list = itemsNew(o, 'ring');
    if (sel === '+') {
      const r = parseRing(val);
      o['ring_' + list.length] = Object.assign({ order: list.length }, r);
      return JSON.stringify(o['ring_' + list.length]);
    }
    const hit = list[Number(sel)] || list.find(x => (x.value.data || '') === sel);
    if (!hit) die('没有这一圈（ballctl get ring 看列表）');
    o[hit.key] = Object.assign({ order: hit.value.order === undefined ? Number(sel) || 0 : hit.value.order }, parseRing(val));
    return JSON.stringify(o[hit.key]);
  }
  if (g === 'content') {
    const list = itemsNew(o, 'content');
    const hit = list[Number(sel)] || list.find(x => x.value.label === sel);
    if (!hit) die('没有这一行（ballctl get content 看列表）');
    const kv = val.includes('=') ? splitKV(val, '行') : [hit.value.label, val];
    hit.value.label = kv[0];
    hit.value.text = kv[1];
    o[hit.key] = hit.value;
    return JSON.stringify(hit.value);
  }
  if (g === 'radial') {
    if (sel === 'radius') {
      o.radial = o.radial || {};
      o.radial.radius = Number(val);
      return JSON.stringify(o.radial);
    }
    const list = itemsNew(o, 'radial');
    const hit = list.find(x => x.value.label === sel) || list[Number(sel)];
    if (hit) {
      hit.value.do = parseAction(val);
      o[hit.key] = hit.value;
      return JSON.stringify(hit.value);
    }
    o['radial_' + list.length] = { order: list.length, label: sel, do: parseAction(val) };
    return JSON.stringify(o['radial_' + list.length]);
  }
  if (g === 'touch') {
    const list = itemsNew(o, 'touch');
    const hit = list.find(x => x.value.on === sel);
    const spec = touchSpec(sel + '=' + val);
    if (hit) {
      o[hit.key] = Object.assign({ order: hit.value.order || 0 }, spec);
      return JSON.stringify(o[hit.key]);
    }
    o['touch_' + list.length] = Object.assign({ order: list.length }, spec);
    return JSON.stringify(o['touch_' + list.length]);
  }
  if (['ringStyle', 'perform', 'bubble', 'noti'].includes(g)) {
    o[g] = o[g] || {};
    const numKeys = ['order', 'stroke', 'gap', 'zoom', 'alpha', 'roll', 'side', 'dark', 'lock', 'silence', 'radius'];
    o[g][sel] = numKeys.includes(sel) ? Number(val) : val;
    return JSON.stringify(o[g]);
  }
  if (g === 'chain') die('chain 用 ballctl chain add / rm');
  die('edit 不支持 ' + g);
}

// ---------------- 事件规则 ----------------
function evRules(o) {
  const out = [];
  for (const k of Object.keys(o)) {
    if (!/^when_[a-zA-Z0-9_]{1,16}$/.test(k)) continue;
    const r = o[k] || {};
    out.push({ key: k, order: r.order === undefined ? 99 : Number(r.order), r });
  }
  out.sort((x, y) => x.order - y.order || String(x.key).localeCompare(String(y.key)));
  return out;
}

function evDesc(r) {
  const c = [];
  if (r.lt !== undefined) c.push('<' + r.lt);
  if (r.gt !== undefined) c.push('>' + r.gt);
  if (r.eq !== undefined) c.push('=' + r.eq);
  if (r.match !== undefined) c.push('匹配 ' + r.match);
  if (r.field !== undefined) c.push('看 ' + r.field);
  const a = r.do || {};
  const arg = a.text ? ' "' + a.text + '"' : a.page ? ' ' + a.page : '';
  return 'on=' + r.on + (c.length ? ' ' + c.join(' ') : '') + '  →  ' + a.type + arg +
    '   冷却 ' + (r.cooldown === undefined ? 30 : r.cooldown) + 's';
}

function evAction(spec) {
  if (!spec) die('缺动作（bubble:文本 / notify:标题|正文 / toast:文本 / expand / collapse / menu / reload / open:页面）');
  if (spec.startsWith('bubble:')) return { type: 'bubble', text: spec.slice(7) };
  if (spec.startsWith('notify:')) {
    const p2 = spec.slice(7).split('|');
    return { type: 'notify', title: p2[0] || '悬浮球', text: p2[1] || '' };
  }
  if (spec.startsWith('toast:')) return { type: 'toast', text: spec.slice(6) };
  if (['expand', 'collapse', 'toggle', 'menu', 'reload', 'think'].includes(spec)) return { type: spec };
  if (spec.startsWith('open:')) return { type: 'open', page: spec.slice(5) };
  if (spec.startsWith('mute')) return { type: 'mute', minutes: 30 };
  die('不认识的动作 ' + spec);
}

function evFreeKey(o) {
  for (let i = 0; i < 16; i++) if (!o['when_' + i]) return 'when_' + i;
  die('规则已满 16 条');
}

function evFire(on, extras) {
  const rish = path.join(os.homedir(), 'Shizuku', 'rish');
  if (!fs.existsSync(rish)) die('找不到 ' + rish);
  const q = s2 => "'" + String(s2).replace(/'/g, "'\\''") + "'";
  let c = 'am broadcast -n com.aigateway.app/.overlay.EventReceiver -a com.aigateway.app.EVENT --es k ' + q(on);
  for (const e of extras) {
    const i = e.indexOf('=');
    if (i < 0) continue;
    c += ' --es ' + e.slice(0, i) + ' ' + q(e.slice(i + 1));
  }
  const { execFileSync } = require('child_process');
  try {
    execFileSync(rish, ['-c', c], { stdio: ['ignore', 'ignore', 'inherit'], timeout: 20000 });
  } catch (err) {
    die('发送失败: ' + err.message + '（Shizuku 在跑吗）');
  }
  // balld (agw-ball daemon) listens via trigger.json; APP pet gets the am broadcast
  try {
    const tf = path.join(os.homedir(), 'agw-ball', 'trigger.json');
    const ev = {};
    for (const e of extras) { const i = e.indexOf('='); if (i > 0) ev[e.slice(0, i)] = e.slice(i + 1); }
    fs.appendFileSync(tf, JSON.stringify({ on, ev }) + '\n');
  } catch (e) { /* balld not installed: fine */ }
  console.log('  已发送 ' + on + (extras.length ? ' ' + extras.join(' ') : ''));
}

function validateScalar(k, v) {
  const spec = SCALARS[k];
  if (!spec) die('未知键 ' + k + '（可用: ' + Object.keys(SCALARS).join(', ') + '）');
  if (spec.range) {
    const n = Number(v);
    if (!Number.isFinite(n) || n < spec.range[0] || n > spec.range[1]) die(k + ' 需 ' + spec.range[0] + '..' + spec.range[1]);
    return n;
  }
  if (spec.bool) {
    if (v === 'true' || v === true) return true;
    if (v === 'false' || v === false) return false;
    die(k + ' 只能 true/false');
  }
  if (spec.color) {
    if (/^-?\d+$/.test(v) && Number(v) === 0) return 0;
    if (!SCOLOR.test(v)) die(k + ' 需 #RRGGBB / #AARRGGBB / 0');
    return v;
  }
  if (spec.list) {
    return String(v).split(',').map(s => s.trim()).filter(Boolean);
  }
  return String(v);
}

const GROUP_ALIAS = {
  ring: 'ring', rings: 'ring', 'ring_': 'ring',
  content: 'content', contents: 'content', rows: 'content', row: 'content',
  when: 'when', 'when_': 'when', events: 'when', ev: 'when',
  radial: 'radial', menu: 'radial',
  perform: 'perform', bubble: 'bubble',
  touch: 'touch', thing: 'touch', on: 'touch', gesture: 'touch',
  chain: 'chain', noti: 'noti', msg: 'noti',
  ringStyle: 'ringStyle', style: 'ringStyle'
};

/** 新格式的组: ring_0 ring_1 … 按 order 排 */
function itemsNew(o, prefix) {
  const pre = prefix.replace(/_+$/, '') + '_';
  return Object.keys(o)
    .filter(k => k.indexOf(pre) === 0)
    .sort((x, y) => (o[x].order === undefined ? 99 : o[x].order) - (o[y].order === undefined ? 99 : o[y].order))
    .map(k => ({ key: k, value: o[k] }));
}

function countOf(o, g) {
  if (g === 'ring') return itemsNew(o, 'ring').length;
  if (g === 'content') return itemsNew(o, 'content').length;
  if (g === 'radial') return itemsNew(o, 'radial').length;
  if (g === 'touch') return itemsNew(o, 'touch').length;
  if (g === 'when') return evRules(o).length;
  if (g === 'chain') return itemsNew(o, 'chain').length;
  if (g === 'bubble') return 1;
  return o[g] === undefined ? 0 : 1;
}

function getItem(o, g, sel) {
  const pool = g === 'ring' ? itemsNew(o, 'ring')
    : g === 'content' ? itemsNew(o, 'content')
      : g === 'radial' ? itemsNew(o, 'radial')
        : g === 'touch' ? itemsNew(o, 'touch')
          : g === 'chain' ? itemsNew(o, 'chain')
            : g === 'when' ? evRules(o).map(x => ({ key: x.key, value: x.r }))
              : [{ key: g, value: o[g] }];
  return pool.find(x => String(x.key) === String(sel)) || pool[Number(sel)];
}

