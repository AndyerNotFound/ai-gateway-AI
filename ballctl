  };
  writeJson(fileFor(inst), o);
  console.log('  noti: ' + JSON.stringify(o.noti));
  evFire('noti', ['text=' + text, 'time=' + stamp, 'silence=' + o.noti.silence, 'title=' + o.noti.name]);
} else if (cmd === 'chain') {
  const o = readJson(fileFor(inst));
  const sub = rest[0] || 'list';
  if (sub === 'list') {
    const list = itemsNew(o, 'chain');
    if (!list.length) console.log('  （没有连锁）');
    list.forEach((x, i) => console.log('  [' + i + '] on=' + x.value.on + '  动作×' + (x.value.do || []).length +
      (x.value.delay ? '  间隔 ' + x.value.delay + 's' : '') + '   (' + x.key + ')'));
  } else if (sub === 'add') {
    const args = rest.slice(1);
    const on = args.shift() || die('用法: chain add <事件名> <动作> [动作...] [lt= gt= eq= match= cd= delay= label=]');
    const rule = { order: itemsNew(o, 'chain').length, on, cooldown: 30 };
    const acts = [];
    for (const a2 of args) {
      let m;
      if ((m = /^lt=(-?[\d.]+)$/.exec(a2))) rule.lt = Number(m[1]);
      else if ((m = /^gt=(-?[\d.]+)$/.exec(a2))) rule.gt = Number(m[1]);
      else if ((m = /^eq=(.+)$/.exec(a2))) rule.eq = m[1];
      else if ((m = /^match=(.+)$/.exec(a2))) rule.match = m[1];
      else if ((m = /^cd=(\d+)$/.exec(a2))) rule.cooldown = Number(m[1]);
      else if ((m = /^delay=([\d.]+)$/.exec(a2))) rule.delay = Number(m[1]);
      else if ((m = /^field=(\w+)$/.exec(a2))) rule.field = m[1];
      else if ((m = /^label=(.+)$/.exec(a2))) rule.label = m[1];
      else acts.push(evAction(a2.replace(/^it=/, '')));
    }
    if (!acts.length) die('至少给一个动作');
    rule.do = acts;
    if (!rule.label) rule.label = on;
    const key = 'chain_' + rule.order;
    o[key] = rule;
    writeJson(fileFor(inst), o);
    console.log('  ' + key + ': on=' + on + '  动作×' + acts.length + '  ' + JSON.stringify(rule.do));
  } else if (sub === 'rm') {
    const list = itemsNew(o, 'chain');
    const hit = list[Number(rest[1])] || list.find(x => x.key === rest[1]);
    if (!hit) die('没有这一条（ballctl chain list）');
    delete o[hit.key];
    writeJson(fileFor(inst), o);
    console.log('  已删除 ' + hit.key);
  } else die('chain 子命令: list | add | rm');
} else if (cmd === 'ev') {
  const o = readJson(fileFor(inst));
  const sub = rest[0] || 'list';
  const rules = evRules(o);
  if (sub === 'list') {
    if (!rules.length) console.log('  （没有事件规则）');
    rules.forEach((x, i) => console.log('  [' + i + '] ' + evDesc(x.r) + '   (' + x.key + ')'));
  } else if (sub === 'add') {
    const args = rest.slice(1);
    const on = args.shift() || die('用法: ev add <事件名> <动作> [lt= gt= eq= match= cd= field= label=]');
    const rule = { order: rules.length ? Math.max(...rules.map(x => x.order)) + 1 : 0, on, cooldown: 30 };
    let act = null;
    for (const a2 of args) {
      let m;
      if ((m = /^lt=(-?[\d.]+)$/.exec(a2))) rule.lt = Number(m[1]);
      else if ((m = /^gt=(-?[\d.]+)$/.exec(a2))) rule.gt = Number(m[1]);
      else if ((m = /^eq=(.+)$/.exec(a2))) rule.eq = m[1];
      else if ((m = /^match=(.+)$/.exec(a2))) rule.match = m[1];
      else if ((m = /^cd=(\d+)$/.exec(a2))) rule.cooldown = Number(m[1]);
      else if ((m = /^field=(\w+)$/.exec(a2))) rule.field = m[1];
      else if ((m = /^label=(.+)$/.exec(a2))) rule.label = m[1];
      else act = a2;
    }
    rule.do = evAction(act);
    if (!rule.label) rule.label = on;
    const key = evFreeKey(o);
    o[key] = rule;
    writeJson(fileFor(inst), o);
    console.log('  ' + key + ': ' + evDesc(rule));
    console.log('  已写入，60 秒内生效');
  } else if (sub === 'rm') {
    const i = Number(rest[1]);
    const hit = rules[i] || rules.find(x => x.key === rest[1] || x.r.on === rest[1]);
    if (!hit) die('没有这一条（先 ev list）');
    delete o[hit.key];
    writeJson(fileFor(inst), o);
    console.log('  已删除 ' + hit.key + '（' + hit.r.on + '）');
  } else if (sub === 'fire') {
    evFire(rest[1] || die('用法: ev fire <事件名> [k=v ...]'), rest.slice(2));
  } else if (sub === 'on' || sub === 'off') {
    die('没有开关, 用 ev rm 删规则, 或 cd= 调冷却');
  } else die('ev 子命令: list | add | rm | fire');
} else if (cmd === 'reset' || cmd === 'clear') {
  const p = fileFor(inst);
  if (fs.existsSync(p)) { fs.unlinkSync(p); console.log('已删除 ' + p); } else console.log('没有 ' + p);
} else if (cmd === 'check') {
  const what = rest[0];
  if (what !== 'data') die('用法: check data');
  checkData(inst);
} else if (cmd === 'show') {
  show(inst);
} else if (cmd === 'diff') {
  const g = readJson(fileFor('global'));
  const o = readJson(fileFor(inst));
  const keys = new Set([...Object.keys(g), ...Object.keys(o)]);
  let n = 0;
  for (const k of keys) {
    const a = JSON.stringify(g[k]), b = JSON.stringify(o[k]);
    if (a !== b) { console.log('  ' + k + ': 全局=' + (a || '—') + '  本实例=' + (b || '—')); n++; }
  }
  if (!n) console.log('  本实例没有覆盖任何键');
} else if (cmd === 'watch') {
  let last = null;
  console.log('盯着 ' + inst + '（Ctrl-C 退出）');
  setInterval(() => api(inst, (e, j) => {
    if (e) { console.log('拉取失败: ' + e.message); return; }
    if (j.hash !== last) { last = j.hash; console.log(new Date().toLocaleTimeString() + '  hash=' + j.hash + '  keys=' + Object.keys(j.look || {}).join(',')); }
  }), 2000);
} else if (cmd === 'ui') {
  const sub = rest[0];
  const UIDIR = path.join(DIR, 'ui');
  if (sub === 'list') {
    (fs.existsSync(UIDIR) ? fs.readdirSync(UIDIR).filter(x => x.endsWith('.json')) : []).forEach(x => {
      console.log(x.replace(/\.json$/, '') + '\t' + fs.statSync(path.join(UIDIR, x)).size + 'B');
    });
  } else if (sub === 'get') {
    const n = rest[1] || die('用法: ui get <name>');
    console.log(fs.readFileSync(path.join(UIDIR, n + '.json'), 'utf8'));
  } else if (sub === 'set') {
    const n = rest[1] || die('用法: ui set <name> <file|->');
    if (!/^[a-z0-9_-]{1,32}$/.test(n)) die('名字只能 [a-z0-9_-]{1,32}');
    const src = (!rest[2] || rest[2] === '-') ? fs.readFileSync(0, 'utf8') : fs.readFileSync(rest[2], 'utf8');
    JSON.parse(src);
    fs.writeFileSync(path.join(UIDIR, n + '.json'), src);
    console.log('已写入 ui/' + n + '.json (' + src.length + 'B)');
  } else if (sub === 'del') {
    const n = rest[1] || die('用法: ui del <name>');
    fs.unlinkSync(path.join(UIDIR, n + '.json'));
    console.log('已删除 ui/' + n + '.json');
  } else die('ui 子命令: list | get | set | del');
} else {
  die('未知命令 ' + cmd + '（ballctl --help 或直接 ballctl 进交互）');
}
