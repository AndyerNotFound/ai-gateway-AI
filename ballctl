    console.log('  d 看数据  t 看触发方式  说明: ballctl get all / get ring / get when\n');
    const c = await ask('选一个数字: ');
    const o = readJson(fileFor(inst));
    const save = () => { writeJson(fileFor(inst), o); console.log('  已写入，60 秒内生效（或长按球 → 刷新）'); };
    if (c === '0' || c === '') { rl.close(); process.exit(0); }
    else if (c === '1' || c === '2' || c === '3') {
      const key = { 1: 'sizeDp', 2: 'gaugeWidth', 3: 'panelDp' }[c];
      const spec = SCALARS[key];
      const a = await ask('  ' + spec.desc + '（' + spec.range[0] + '..' + spec.range[1] + '，当前 ' + (o[key] === undefined ? '默认' : o[key]) + '，回车跳过）: ');
      if (a) { o[key] = validateScalar(key, a); save(); }
    } else if (c === '4') {
      const a = await ask('  颜色 #RRGGBB（当前 ' + (o.gaugeColor || '默认') + '，回车跳过）: ');
      if (a) { o.gaugeColor = validateScalar('gaugeColor', a); save(); }
    } else if (c === '5') {
      console.log('  例: ctxSoft:warn ctxHard:ok balance:danger 35/100:info');
      const a = await ask('  环（回车跳过）: ');
      if (a) { applySet(o, 'rings', a.split(/[\s,]+/).filter(Boolean)); save(); }
    } else if (c === '6') {
      console.log('  例: \'实例={{state.inst}}\' \'请求={{state.requests}}\'');
      const a = await ask('  行，用 ; 分隔（回车跳过）: ');
      if (a) { applySet(o, 'rows', a.split(';').map(x => x.trim()).filter(Boolean)); save(); }
    } else if (c === '7') {
      console.log('  例: 刷新=reload APP=open:overview 静音=mute:30');
      const a = await ask('  菜单项，用 ; 分隔（回车跳过）: ');
      if (a) { applySet(o, 'radial', a.split(';').map(x => x.trim()).filter(Boolean)); save(); }
    } else if (c === '8') {
      console.log('  例: tap=expand longPress=menu');
      const a = await ask('  手势（回车跳过）: ');
      if (a) { applySet(o, 'on', a.split(/[\s,]+/).filter(Boolean)); save(); }
    } else if (c === '9') printAll(o);
    else if (c === 'd') dataTree(inst);
    else if (c === 't') printTouch(o);
    else console.log('  没有这个选项');
  }
}

